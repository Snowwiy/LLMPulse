{
  "$schema": "https://opencode.ai/config.json",

  "model": "llama.cpp/qwen36-fast-80k",

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Raven Local - llama.cpp",

      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "local"
      },

      "models": {
        "qwen36-fast-80k": {
          "name": "Qwen3.6 35B FAST 80K",
          "limit": {
            "context": 81920,
            "output": 8192
          }
        },

        "mimo-v26-q8-80k": {
          "name": "MiMo V2.6 9B Q8 80K",
          "limit": {
            "context": 81920,
            "output": 8192
          }
        },
		
		"qwen38-aggressive-iq2m-50k": {
           "name": "Qwen3.8 Aggressive IQ2_M 50K",
           "limit": {
             "context": 51200,
             "output": 8192
          }
        },
		
		"qwen38-aggressive-q2kp-32k": {
           "name": "Qwen3.8 Aggressive Q2_K_P 32K",
           "limit": {
             "context": 32768,
             "output": 8192
          }
        },
		
		"deepseek-coder-v2-lite-q4-20k": {
           "name": "DeepSeek Coder V2 Lite Q4 20K",
           "limit": {
             "context": 20480,
             "output": 4096
          }
        },
		
        "qwen38-quality-16k": {
          "name": "Qwen3.8 27B QUALITY 16K",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  },


  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",

    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "cargo *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow"
    },

    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}