{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLMPulse",
  "version": "1.0.0",
  "identifier": "com.llmpulse.llmpulse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLMPulse",
        "width": 340,
        "height": 250,
        "minWidth": 320,
        "minHeight": 230,
        "resizable": true,
        "center": false,
        "decorations": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
